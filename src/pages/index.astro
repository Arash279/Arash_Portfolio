---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { PROFILE, SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import { url } from '../utils/paths';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION}>
  <section class="hero" aria-labelledby="intro-title"><div><p class="eyebrow">Electrical Engineer · Power Electronics · Machines · EMC</p><h1 id="intro-title">{PROFILE.name || 'Electrical systems, models, and evidence.'}</h1><p>I’m an electrical engineer finishing my M.Sc. at the National University of Singapore (December 2026). I build models that predict how motors, drives and EMI filters behave from mains frequency up to radio frequency, and I make them fast enough to use in real design work. One example is a motor model that fits in about 20 seconds on a laptop. Another is a choke predictor that beat a published neural-network benchmark on 39 parts it had never seen.</p><p>I also bring a design-institute internship on a 90 MWp solar and battery-storage bid, and a machine-learning Final Year Project that flags copied chip-design code.</p><p class="profile-availability">{PROFILE.location} · {PROFILE.availability}</p><div class="hero-actions"><a class="btn" href={url('/projects/')}>View projects <span aria-hidden="true">→</span></a>{PROFILE.cv && <a class="btn-outline" href={url(PROFILE.cv)}>View CV (PDF)</a>}<a class="btn-outline" href={url('/about/')}>About my work</a></div></div><div class="portrait-wrap">{PROFILE.photo ? <img class="portrait" src={url(PROFILE.photo)} alt={PROFILE.name} width="200" height="200" /> : <div class="portrait-placeholder" aria-hidden="true"></div>}</div></section>
  <section aria-labelledby="featured-title"><div class="section-heading"><h2 id="featured-title">Featured projects</h2><a href={url('/projects/')}>Explore all four →</a></div><div class="project-grid">{projects.map(project => <ProjectCard project={project} />)}</div></section>
  <section class="capabilities" aria-labelledby="capabilities-title"><div class="section-heading"><h2 id="capabilities-title">Core capabilities</h2></div><div class="capability-grid">
    <div><span class="capability-number">01 / Model</span><h3>Electrical Modeling</h3><p>Wideband circuit models of motors and EMI components, built from a single impedance sweep and fitted in seconds. Useful for EMI filter design, insulation stress checks and drive simulation.</p><a href={url('/projects/induction-motor/')}>See the motor model →</a></div>
    <div><span class="capability-number">02 / Compute</span><h3>Scientific Computing & ML</h3><p>Python, NumPy, SciPy and PyTorch for optimization, data pipelines and classifiers, including synthetic data when real examples are scarce. Coursework: Neural Networks (A) and Machine Learning.</p><a href={url('/projects/verilog-code-similarity/')}>See the ML project →</a></div>
    <div><span class="capability-number">03 / Communicate</span><h3>Technical Analysis & Writing</h3><p>Fair head-to-head comparisons, clear figures and concise reports. Co-author of a journal review on high-frequency modeling of inverter-fed machines.</p><a href={url('/projects/machine-modeling-review/')}>See the review →</a></div>
  </div></section>
  <section id="contact" class="contact-section" aria-labelledby="contact-title"><div><p class="eyebrow">Contact</p><h2 id="contact-title">Looking for my first<br />full-time engineering role.</h2></div><div><p>I’m open to full-time roles in Singapore from January 2027: power electronics, electric machines and drives, EMC and testing, equipment and test engineering, and engineering R&D. Email is the fastest way to reach me.</p><p class="contact-note">{PROFILE.location} · {PROFILE.availability}</p><div class="contact-links">{PROFILE.email && <a href={'mailto:' + PROFILE.email}>{PROFILE.email} ↗</a>}{PROFILE.github && <a href={PROFILE.github}>GitHub ↗</a>}{PROFILE.linkedin && <a href={PROFILE.linkedin}>LinkedIn ↗</a>}{PROFILE.phone && <a href={'tel:' + PROFILE.phone.replace(/\s/g, '')}>{PROFILE.phone}</a>}</div>{!PROFILE.email && !PROFILE.github && !PROFILE.linkedin && <p class="contact-note">Public contact details will be added before launch.</p>}</div></section>
</BaseLayout>
