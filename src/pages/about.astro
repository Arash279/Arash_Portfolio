---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import { PROFILE } from '../consts';
import { url } from '../utils/paths';
const projects = (await getCollection('projects')).sort((a,b) => a.data.order - b.data.order);
---
<BaseLayout title="About" description="About Fengyifei XU: electrical engineer, NUS M.Sc. (Dec 2026), working on wideband motor and EMI models, power electronics and machine learning.">
  <div class="about-body"><p class="eyebrow">About</p><h1>Fast, practical models<br />for real electrical hardware.</h1>
  <p>I’m Fengyifei XU, an electrical engineer finishing my M.Sc. at the National University of Singapore in December 2026, after a B.Eng. in Electrical Engineering and Automation at Sichuan University (top 3% of the major). I’m based in Singapore and available for full-time work from January 2027.</p>
  <p>My strongest work is in wideband modeling of motors and EMI components. For a 1.5 HP induction motor, I built a circuit model that tracks the machine from 100 Hz to 100 MHz, fits in about 20 seconds on a laptop and gives the same answer on every run. For common-mode chokes, I built a simple resonance-aligned predictor that beat a published neural-network benchmark on 39 unseen parts. I also co-authored a journal review that helps engineers pick the right high-frequency machine model for the question they need to answer.</p>
  <p>On the machine-learning side, my Final Year Project detects copied Verilog code to help protect chip-design IP. It catches 97% of copied pairs and scores about 2.7× higher than MOSS, the standard academic tool, and was selected for the NUS (Suzhou) Research Institute Best Projects Showcase.</p>
  <p>Before my Master’s, I interned at a power design institute on a 90 MWp solar and 80.2 MWh battery-storage bid. I’m looking for roles in power electronics, electric machines and drives, EMC and testing, equipment engineering and engineering R&D, where I can turn measurements into models and models into decisions.</p>
  {PROFILE.education.length > 0 && <section><h2>Education</h2><div class="background-list">{PROFILE.education.map(e => <div class="background-entry"><p class="eyebrow">{e.period}</p><h3>{e.qualification}</h3><p class="institution">{e.institution}</p><ul>{e.details.map(detail => <li>{detail}</li>)}</ul></div>)}</div></section>}
  {PROFILE.experience.length > 0 && <section><h2>Professional experience</h2><div class="background-list">{PROFILE.experience.map(e => <div class="background-entry"><p class="eyebrow">{e.period}</p><h3>{e.role}</h3><p class="institution">{e.organization}</p><p>{e.description}</p><ul>{e.details.map(detail => <li>{detail}</li>)}</ul></div>)}</div></section>}
  <section><h2>Projects</h2><ul class="research-list">{projects.map(p => <li><p class="eyebrow">{p.data.category}{p.data.period && ' / ' + p.data.period}</p><h3><a href={url('/projects/' + p.id + '/')}>{p.data.shortTitle}</a></h3><p>{p.data.role}</p><p>{p.data.summary}</p><span class="status">{p.data.status}</span></li>)}</ul></section>
  <section><h2>Technical toolkit</h2><div class="skill-list"><div><h3>Electrical engineering</h3><p>Electric machines and drives, power electronics, EMI/EMC, common- and differential-mode impedance, equivalent circuits and parameter identification.</p></div><div><h3>Scientific programming</h3><p>Python, NumPy, SciPy, C/C++, SQLite, and Excel formulas, macros, and pivot tables.</p></div><div><h3>Simulation & design</h3><p>MATLAB/Simulink, feedback-control tuning, Multisim, PVsyst, Candela, and solar PV / BESS design basics.</p></div><div><h3>Measurement data</h3><p>Impedance-analyzer and oscilloscope data: magnitude/phase conversion, data cleaning, and model-versus-measurement checks.</p></div><div><h3>Machine learning</h3><p>PyTorch classifiers, feature engineering, synthetic data (Gaussian Copula, conditional GANs) and evaluation on imbalanced data. Coursework: Neural Networks (A), Machine Learning.</p></div><div><h3>Technical writing</h3><p>Reports, technical figures, literature reviews and a co-authored journal manuscript; English technical-proposal material.</p></div></div></section>
  <section><h2>Selected honors</h2><ul class="background-bullets"><li>Provincial Gold Award, 9th Sichuan “Internet+” Innovation & Entrepreneurship Competition (2023).</li><li>National College Student Innovation Program project rated Provincial Excellent (2023).</li><li>College First-Class Comprehensive Scholarship, School of Electrical Engineering, Sichuan University (2023).</li><li>Final Year Project selected for the Best Projects Showcase, NUS (Suzhou) Research Institute (2025).</li></ul></section>
  <section><h2>Leadership & languages</h2><h3>31st FISU Summer World University Games</h3><p class="institution">Volunteer & Student Work-Group Leader · Chengdu · 2023</p><p>Coordinated volunteer tasks and resource scheduling, liaised with international student volunteers, and supported contingency planning and on-site incident handling.</p><p>Mandarin (native), English (IELTS 7.0), Japanese (conversational), and German (beginner).</p></section>
  {PROFILE.cv && <section><h2>Curriculum vitae</h2><a class="btn" href={url(PROFILE.cv)}>View CV / Resume (PDF) ↗</a></section>}
  <section><a class="btn-outline" href={url('/#contact')}>Contact →</a></section></div>
</BaseLayout>
