---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
interface Props { title: string; description: string; noindex?: boolean; class?: string }
const { title, description, noindex, class: className } = Astro.props;
---
<!doctype html><html lang="en"><head><BaseHead title={title} description={description} noindex={noindex} /></head><body><Header /><main id="main" tabindex="-1" class={className}><slot /></main><Footer /></body></html>
