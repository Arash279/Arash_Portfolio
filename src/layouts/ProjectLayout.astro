---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import TableOfContents from '../components/TableOfContents.astro';
import ProjectGlance from '../components/ProjectGlance.astro';
import ProjectCover from '../components/ProjectCover.astro';
import { url } from '../utils/paths';
interface Props { project: CollectionEntry<'projects'>; headings: MarkdownHeading[]; next: CollectionEntry<'projects'> }
const { project, headings, next } = Astro.props;
const p = project.data;
---
<BaseLayout title={p.title} description={p.abstract} class="project-page">
  <div class="article-shell"><article>
    <div class="project-heading"><a class="back-link" href={url('/projects/')}>← All projects</a><p class="eyebrow">{p.category} / Research case study</p><h1>{p.title}</h1><div class="project-status"><span class="status">{p.status}</span>{p.period && <span>{p.period}</span>}</div><ProjectCover src={p.thumbnail} alt={p.thumbnailAlt} hero /><p class="project-abstract">{p.abstract}</p><dl class="project-meta"><div><dt>Role</dt><dd>{p.role}</dd></div>{p.supervisor && <div><dt>Supervision</dt><dd>{p.supervisor}</dd></div>}</dl>{p.resourceLinks.length > 0 && <div class="resources">{p.resourceLinks.map(link => <a class="btn-outline" href={url(link.href)}>{link.label} ↗</a>)}</div>}</div>
    <ProjectGlance id={project.id} />
    {p.toc && <TableOfContents headings={headings} mobile />}
    <div class="prose"><slot /></div>
    <a class="next-project" href={url('/projects/' + next.id + '/')}><span class="eyebrow">Next project →</span><span>{next.data.shortTitle}</span></a>
  </article>{p.toc && <aside><TableOfContents headings={headings} /></aside>}</div>
</BaseLayout>
