---
import { url } from '../utils/paths';
interface Props { src: string; alt: string; hero?: boolean }
const { src, alt, hero = false } = Astro.props;
---
<div class:list={['project-cover', { 'project-cover-hero': hero }]}>
  <img src={url(src)} alt={alt} width="1200" height="750" loading={hero ? 'eager' : 'lazy'} decoding="async" />
</div>
<style>
  .project-cover { width:100%; height:100%; background:#edf3f8; overflow:hidden; }
  .project-cover img { display:block; width:100%; height:100%; object-fit:cover; object-position:center; }
  .project-cover-hero { height:auto; aspect-ratio:2/1; margin:26px 0 30px; border:1px solid var(--color-border); border-radius:var(--radius); }
  @media(max-width:600px) { .project-cover-hero { aspect-ratio:16/10; margin:22px 0 26px; } }
</style>
