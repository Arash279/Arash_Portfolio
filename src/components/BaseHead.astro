---
import '../styles/global.css';
import 'katex/dist/katex.min.css';
import { SITE_TITLE } from '../consts';
import { url } from '../utils/paths';
interface Props { title: string; description: string; noindex?: boolean }
const { title, description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname.replace(/\/404\/$/, '/404.html'), Astro.site);
const published = !!import.meta.env.SITE_URL;
---
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<title>{title === SITE_TITLE ? title : title + ' | ' + SITE_TITLE}</title>
<meta name="description" content={description} />
{(noindex || !published) && <meta name="robots" content="noindex, nofollow" />}
<link rel="canonical" href={canonical} />
<link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
<link rel="preload" href={url('/fonts/atkinson-regular.woff')} as="font" type="font/woff" crossorigin />
<meta property="og:type" content="website" />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:site_name" content={SITE_TITLE} />
<meta property="og:image" content={new URL(url('/images/social-card-2026.png'), Astro.site)} />
<meta name="twitter:card" content="summary_large_image" />
<style is:inline set:html={`@font-face{font-family:Atkinson;src:url('${url('/fonts/atkinson-regular.woff')}') format('woff');font-weight:400;font-display:swap}@font-face{font-family:Atkinson;src:url('${url('/fonts/atkinson-bold.woff')}') format('woff');font-weight:700;font-display:swap}`} />
<script is:inline>
  (() => {
    let theme = 'light';
    try { if (localStorage.getItem('theme') === 'dark') theme = 'dark'; } catch {}
    document.documentElement.dataset.theme = theme;
    document.documentElement.style.colorScheme = theme;
  })();
</script>
